# speakr-mcp environment configuration
# Copy to .env and fill in your values:   cp .env.example .env
# NOTE: .env is gitignored — never commit real tokens.

# Your Speakr API token (Speakr → Account → API Tokens).
# REQUIRED — the container refuses to start without it.
SPEAKR_TOKEN=

# Internal address of the Speakr API *as seen from this container*.
# Use the container/service name + internal port, NOT the public hostname.
SPEAKR_API_URL=http://speakr:8000/api/v1/

# MCP server port (optional, default 3000)
MCP_PORT=3000
